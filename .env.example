# Salin nilai dari Firebase Console -> Project Settings -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sim-yayasan-terpadu-ybmg.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sim-yayasan-terpadu-ybmg
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Email PEMILIK (selalu boleh masuk & mengelola admin lain), pisahkan dengan koma.
# Samakan dengan isOwner() di firestore.rules. Admin tambahan TIDAK perlu ditulis di sini:
# tambahkan lewat panel Admin → tab "Admin" (disimpan di koleksi Firestore `admins`).
NEXT_PUBLIC_ADMIN_EMAILS=achfif@gmail.com

# OPSIONAL - kosongkan jika tidak memakai Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

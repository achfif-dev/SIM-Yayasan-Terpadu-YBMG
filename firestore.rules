rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PEMILIK: satu-satunya tempat email ditulis di rules (samakan dengan NEXT_PUBLIC_ADMIN_EMAILS).
    // Pemilik selalu punya akses penuh dan mengelola admin lain dari panel (tab "Admin").
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['achfif@gmail.com']; // ganti / tambah email pemilik
    }

    // ADMIN: pemilik, atau email yang terdaftar di koleksi `admins` (ID dokumen = email huruf kecil)
    function isAdmin() {
      return isOwner()
        || (request.auth != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())));
    }

    // Statistik pengunjung: pengunjung hanya boleh MENAMBAH hitungan harian (maks +1 per tulisan, tanpa data pribadi)
    function statNaik(k) { return (request.resource.data.get(k, 0) - resource.data.get(k, 0)) in [0, 1]; }
    function statAwal(k) { return request.resource.data.get(k, 0) in [0, 1]; }

    // Transaksi kas: jenis harus masuk/keluar, jumlah harus angka > 0
    function validTrx() {
      return request.resource.data.tipe in ['masuk', 'keluar']
        && request.resource.data.jumlah is number
        && request.resource.data.jumlah > 0;
    }

    // Koleksi yang tampil di beranda: baca publik, tulis hanya admin
    match /settings/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /institutions/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /board_members/{id} { allow read: if true; allow write: if isAdmin(); }
    match /announcements/{id} { allow read: if true; allow write: if isAdmin(); }
    match /events/{id}        { allow read: if true; allow write: if isAdmin(); }
    match /gallery/{id}       { allow read: if true; allow write: if isAdmin(); }

    // Daftar admin tambahan: tiap orang hanya boleh membaca dokumennya sendiri (untuk cek akses saat login);
    // melihat seluruh daftar dan menambah/mencabut admin hanya untuk pemilik.
    match /admins/{email} {
      allow get: if request.auth != null && request.auth.token.email.lower() == email;
      allow list, write: if isOwner();
    }

    // Kegiatan rutin: 1 dokumen = 1 aturan pengulangan. Pengulangan harus salah satu dari daftar di bawah.
    match /routine_events/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.frekuensi in ['harian', 'mingguan', 'dua_pekan', 'bulanan_tanggal', 'bulanan_pekan', 'tahunan', 'hijriah_bulanan', 'hijriah_tahunan']
        && request.resource.data.judul is string && request.resource.data.judul.size() > 0
        && request.resource.data.mulai is string;
      allow delete: if isAdmin();
    }

    match /transactions/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validTrx();
      allow delete: if isAdmin();
    }

    // Bukti nota: boleh dibuka bila tahu ID-nya (get), tetapi daftar seluruh bukti (list) hanya admin
    match /receipts/{id} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Riwayat perubahan kas: hanya admin yang bisa baca/tambah; tidak bisa diubah atau dihapus
    match /audit_log/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Hitungan pengunjung per hari (ID dokumen = YYYY-MM-DD). Baca & hapus hanya admin.
    // Catatan: aturan tidak bisa membatasi jumlah tulisan per detik, jadi angka ini perkiraan, bukan alat audit.
    match /stats_harian/{tgl} {
      allow read, delete: if isAdmin();
      allow create: if tgl.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['tanggal', 'kunjungan', 'unik', 'hp', 'desktop', 'src_langsung', 'src_google', 'src_facebook', 'src_instagram', 'src_whatsapp', 'src_telegram', 'src_lain'])
        && request.resource.data.tanggal == tgl
        && request.resource.data.kunjungan == 1
        && statAwal('unik') && statAwal('hp') && statAwal('desktop')
        && statAwal('src_langsung') && statAwal('src_google') && statAwal('src_facebook') && statAwal('src_instagram')
        && statAwal('src_whatsapp') && statAwal('src_telegram') && statAwal('src_lain');
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kunjungan', 'unik', 'hp', 'desktop', 'src_langsung', 'src_google', 'src_facebook', 'src_instagram', 'src_whatsapp', 'src_telegram', 'src_lain'])
        && (request.resource.data.get('kunjungan', 0) - resource.data.get('kunjungan', 0)) == 1
        && statNaik('unik') && statNaik('hp') && statNaik('desktop')
        && statNaik('src_langsung') && statNaik('src_google') && statNaik('src_facebook') && statNaik('src_instagram')
        && statNaik('src_whatsapp') && statNaik('src_telegram') && statNaik('src_lain');
    }

    // Koleksi lain yang tidak disebut di atas: ditolak (default)
  }
}
